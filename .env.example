# =============================================================================
# ETHack environment variables — copy to `.env` and fill in real values.
# `.env` is gitignored (see .gitignore); NEVER commit real keys. This example file
# is safe to commit because it contains only placeholders.
# =============================================================================

# --- Supabase (service-to-service; RLS disabled for hackathon) ---------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- EIA (U.S. Energy Information Administration) crude price API ------------
# Get a free key at https://www.eia.gov/opendata/  (read via os.getenv in ingest_eia.py)
EIA_API_KEY=your-eia-api-key

# --- LLM provider selection (Stage 3 explanations, route rationale) ----------
# groq (free, default) | gemini | grok
LLM_PROVIDER=groq

# Groq (free) — https://console.groq.com
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional) — https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
